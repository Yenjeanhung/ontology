          <mxGeometry x="60" y="410" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e-rt" value="_Runtime 运行上下文&#10;events: asyncio.Queue 事件总线&#10;replay / inject / suspend&#10;node_states 节点状态表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-build" value="_build_graph：JSON 定义 → StateGraph（每次运行重建+compile，毫秒级）&#10;add_node(闭包) · add_conditional_edges · START→start节点→…→END&#10;graph.astream(state, config={thread_id: wf-{run_id}}, stream_mode=&quot;updates&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="390" y="410" width="460" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e-state" value="GraphState（TypedDict）&#10;start: dict&#10;outputs: Annotated[dict, _merge_outputs]&#10;reducer：并行写按 node_id 合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e-nodefn" value="_make_node_fn 节点闭包&#10;① inject：人工结果直接注入&#10;② replay：已完成节点 O(1) 重放&#10;③ 常规执行 + emit 事件&#10;（progress 80ms 节流 · 2s 心跳）&#10;④ 失败 fail-fast 上抛终止整图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="390" y="525" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e-cond" value="_make_condition_router&#10;按 true/false handle 路由&#10;（多条边并行扇出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="525" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e-hr" value="_make_human_router&#10;approve：approved→true/false 分支&#10;form：恒走唯一出口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">

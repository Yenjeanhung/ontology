# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库
# SQLite（默认，零配置）：sqlite+aiosqlite:///./data/knowsource.db
# PostgreSQL（推荐，docker-compose 提供）：postgresql+asyncpg://ontology:ontology123@localhost:5432/knowsource
DATABASE_URL=postgresql+asyncpg://ontology:ontology123@localhost:5432/knowsource

# 嵌入模型配置
# EMBEDDING_PROVIDER: local (sentence-transformers 本地) 或 openai (在线 API)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
# HuggingFace 模型本地缓存目录，配置后优先从本地加载，不再访问 huggingface.co
HF_CACHE_DIR= 
# 公司台式机的缓存目录
# HF_CACHE_DIR=E:\server\model\huggingface_cache
# dell xps159510的缓存目录
# HF_CACHE_DIR=C:\Users\Administrator\.cache\huggingface\hub

# 以下仅在 EMBEDDING_PROVIDER=openai 时使用
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# 向量存储配置
# VECTOR_STORE_PROVIDER: chroma 或 milvus
VECTOR_STORE_PROVIDER=milvus
CHROMA_PERSIST_DIR=./data/chroma
# 以下仅在 VECTOR_STORE_PROVIDER=milvus 时使用（docker-compose 默认端口 19530）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 图数据库配置
# GRAPH_STORE_PROVIDER: kuzu 或 neo4j（当前默认 neo4j）
GRAPH_STORE_PROVIDER=neo4j
# 仅 GRAPH_STORE_PROVIDER=kuzu 时需要
# KUZU_DB_PATH=./data/graph/graph.kuzu
# 以下仅在 GRAPH_STORE_PROVIDER=neo4j 时使用
# 密码需与 docker-compose.yml 中 NEO4J_AUTH 的第二段保持一致
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology123
NEO4J_DATABASE=neo4j
# 图谱实体/关系抽取配置
GRAPH_ENTITY_EXTRACTION_ENABLED=true
GRAPH_EXTRACTION_BATCH_SIZE=6
GRAPH_EXTRACTION_CONCURRENCY=3
GRAPH_MIN_CHARS_FOR_EXTRACTION=80
GRAPH_MAX_ENTITIES_PER_CHUNK=12
GRAPH_MAX_RELATIONS_PER_CHUNK=12


# 召回配置，召回太多无关内容就调高，漏召回就调低
SIMILARITY_THRESHOLD=0.4

# 混合检索（BM25 + 向量）
BM25_ENABLED=true
BM25_RECALL_K=50
HYBRID_TOP_N=12
HYBRID_RRF_K=60

# 查询改写（Multi-Query）：用 LLM 生成查询变体多路召回，提升口语化提问的召回率
# 关闭时与旧行为一致；开启后每次问答多消耗一次 LLM 调用
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_COUNT=3

# Rerank 精排：RRF 融合后用 cross-encoder / LLM 二次打分
# cross-encoder 首次使用需下载模型（默认 BAAI/bge-reranker-base）；无外网时改 llm
# 模型来源与嵌入模型共用上方 HF_CACHE_DIR：配置后优先本地缓存离线加载，未命中自动在线下载
RERANK_ENABLED=false
RERANK_PROVIDER=cross-encoder
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_K=30
RERANK_TOP_N=12

# 文件上传
UPLOAD_DIR=./uploads
CHUNK_DIR=./chunks
MAX_FILE_SIZE=52428800

# 文本分块（全局兜底默认，通常无需配置）
# 分片策略与参数由「上传后自动分析 + 处理确认弹窗」按文件确认并持久化（decided_by=user）；
# 以下仅在文件未分析或批量处理未确认时作为兜底（代码默认值见 config.py）。
# CHUNK_STRATEGY: fixed (固定长度), sentence (句子/段落), recursive (递归字符),
#                 semantic (语义), heading (层级/标题)
# CHUNK_STRATEGY=recursive
# CHUNK_SIZE=800
# CHUNK_OVERLAP=80
# 分片后端：self = 自研实现（默认）；langchain = 优先 langchain_text_splitters
# 影响 recursive / heading(markdown) / semantic(需 langchain-experimental) 三种策略；
# 依赖缺失或非 markdown 文档会自动回落 self，不会中断
CHUNK_BACKEND=self

# 文档解析 Tika 兜底（可选）
# 未知格式（pptx/xlsx/html/eml 等）由 Tika 兜底解析；txt/md/pdf/docx 永远走专用轻量库。
# 无 JRE 时 Tika 自动关闭并降级，不影响应用启动与轻量格式解析。
TIKA_FALLBACK_ENABLED=true
# 外部共享 Tika Server：设置后走远端，可免装本地 JRE（如 http://tika:9998）
# TIKA_SERVER_ENDPOINT=http://tika:9998
# 显式指定 java 可执行路径，留空则用 PATH 中的 java
# TIKA_JAVA_PATH=

# 数据采集用的搜索引擎（tavily / bing / duckduckgo），推荐用tavily，每月1000次免费额度,需要注册获取API_KEY,https://www.tavily.com/
SEARCH_PROVIDER=bing
TAVILY_API_KEY=
# 直连抓取失败 / 正文过短（如今日头条等 JS 渲染页）时，回退到 Jina Reader 渲染抓正文
CRAWL_JINA_FALLBACK=true
# Jina API Token，配置后走更高额度且更稳；留空用免费匿名额度（有频率限制）。注册：https://jina.ai/
CRAWL_JINA_TOKEN=


# skill文件上传目录
SKILL_FILES_DIR=../data/skills


# ── 用户与权限（Auth / RBAC）──
# AUTH_ENABLED=false 可临时关闭全站登录校验（本地调试用）；也可用页面「角色权限 → 安全策略」在线改
AUTH_ENABLED=true
# JWT 签名密钥：留空时首次启动自动生成并持久化到 data/.auth_secret_key。
# 多副本部署请显式配置成同一个值，否则各副本签发的令牌互不认可。
AUTH_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=120                      # 访问令牌有效期
REFRESH_TOKEN_TTL_DAYS=7                          # 刷新令牌有效期
AUTH_CACHE_TTL_SECONDS=10                         # 会话状态缓存时长，决定多副本下"踢人"生效延迟上限
AUDIT_BATCH_SIZE=100                              # 审计日志批量落库条数
AUDIT_FLUSH_INTERVAL_SECONDS=1.0                  # 审计日志攒批最长窗口（秒）
# CORS 白名单（逗号分隔）。留空 = 沿用 *；配置后收紧并允许携带凭证
CORS_ALLOW_ORIGINS=

# 日志配置
SERVICE_TRACE_ENABLED=false                       # 关闭方法级日志
SERVICE_TRACE_LEVEL=INFO                          # 提到控制台可见（会刷屏）
SERVICE_TRACE_SLOW_MS=3000                        # 慢调用阈值，默认 1000ms
SERVICE_TRACE_LOG_ARGS=false                      # 只记耗时，不记入参
SERVICE_TRACE_MAX_ARG_LEN=500                     # 单参数截断长度，默认 300
SERVICE_TRACE_EXCLUDE=NotificationChannel,SkillService  # 排除特定类（支持通配）
# ══════════════════════════════════════════════════════════════════════
#  脚本专用环境配置（backend/scripts/.env.scripts）
# ══════════════════════════════════════════════════════════════════════
# 用途：scripts/ 下的离线测试/评估脚本（langsmith/*、rag_eval/*）专用，
#       与服务端 backend/.env 分离——服务运行时用页面配置（存数据库），
#       脚本离线跑用这里，两边互不影响。
# 启用：复制本文件为 .env.scripts 并填写（.env.scripts 已被 .gitignore 忽略）。
#       cp .env.scripts.example .env.scripts
# 优先级：rag_eval 内置 EVAL_LLM_CONFIG > 本文件 > backend/.env > 数据库页面配置
# 本文件未设置的变量（DATABASE_URL / LANGSMITH_* 等）自动回落 backend/.env，
# 共用配置无需在此重复。

# ── LLM 对话模型（数据集出题 / factuality 评估 judge 必需）──
# LLM_PROVIDER: openai = OpenAI 兼容格式（DeepSeek / Qwen / 智谱等均可）
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI 兼容服务地址（官方 OpenAI 可留空），常用示例：
#   智谱   https://open.bigmodel.cn/api/paas/v4                      模型：glm-4-flash
#   DeepSeek   https://api.deepseek.com/v1                           模型：deepseek-chat
#   通义   https://dashscope.aliyuncs.com/compatible-mode/v1         模型：qwen-plus
OPENAI_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

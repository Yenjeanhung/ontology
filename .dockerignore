.trae
.walicode
.workbuddy
.playwright-cli
.pytest_cache

# 文档与设计资产（不参与运行）
doc
issus
assets
*.md

# 运行时产物 / 本地数据（镜像内不携带，K8s 用 PVC）
# ⚠️ backend/sql 不能排除：init_db 启动建表与增量迁移依赖 schema.sql/migrations.sql，
#    排除后全新数据库会漏建表（存量库因表已存在而看不出问题）
backend/chunks
backend/data
backend/uploads
backend/logs
backend/test
chunks
data
logs
uploads
test_data

# Python / Node 缓存与依赖
**/__pycache__
**/*.pyc
.venv
venv
front/node_modules
front/dist

# 本地密钥与配置（运行时通过 env/Secret 注入）
.env
backend/.env
